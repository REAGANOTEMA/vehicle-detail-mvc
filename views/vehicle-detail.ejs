<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= vehicle.make %> <%= vehicle.model %></title>
  <link rel="stylesheet" href="/css/styles.css">
  <style>
    .vehicle-detail {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      align-items: flex-start;
      gap: 2em;
      padding: 2em;
      background-color: #f9f9f9;
      border-radius: 10px;
      box-shadow: 0 0 15px rgba(0,0,0,0.1);
      animation: fadeIn 0.8s ease-in;
    }
    .vehicle-image {
      max-width: 400px;
      width: 100%;
      border-radius: 8px;
      box-shadow: 0 0 10px rgba(0,0,0,0.15);
    }
    .vehicle-info {
      max-width: 500px;
    }
    @keyframes fadeIn {
      0% { opacity: 0; transform: translateY(20px); }
      100% { opacity: 1; transform: translateY(0); }
    }
    .animate-fade { animation: fadeIn 0.8s ease-in; }
  </style>
</head>
<body>
  <header>
    <nav>
      <a href="/">Home</a>
      <a href="/inventory/vehicle/1">Sample Vehicle</a>
      <a href="/inventory/trigger-error">Trigger 500 Error</a>
    </nav>
  </header>

  <main>
    <div>
      <%- html %>
    </div>
  </main>

  <footer>
    <p>&copy; <%= new Date().getFullYear() %> Reagan Otema</p>
  </footer>
</body>
</html>
